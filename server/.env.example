# GS Multiplayer server configuration.
# Copy to .env (or a systemd EnvironmentFile) and adjust.

# TCP port for the signaling WebSocket + health HTTP endpoint.
SIGNALING_PORT=35500

# UDP port for the packet relay.
RELAY_PORT=35501

# Public IP or hostname of this server as seen by players.
# Required for the relay fallback; without it the relay is disabled.
RELAY_PUBLIC_HOST=203.0.113.10

# Shared HMAC secret used to sign relay tokens. MUST be set in production
# and be identical for the signaling and relay processes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_SECRET=please-change-me

# Maximum players per room (including the host). The mod targets 4.
MAX_PLAYERS=4
